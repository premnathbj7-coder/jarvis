# ============================================================
# JARVIS Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to version control.
# ============================================================

# --- AI Provider ---
# Anthropic API key. Get one at https://console.anthropic.com/
AI_API_KEY=your_key_here
AI_MODEL=claude-sonnet-4-6

# --- Web Search (optional) ---
# Used for current-events / live information queries.
# Get a key at https://serpapi.com/ or leave blank to disable.
SEARCH_API_KEY=

# --- Weather (optional) ---
# Get a free key at https://openweathermap.org/api
WEATHER_API_KEY=

# --- Wake Word (optional) ---
# Porcupine access key from https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=

# --- Misc ---
JARVIS_ENV=development
